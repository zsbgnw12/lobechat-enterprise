# Overlay for a SkillHub sidecar that does not collide with this repo's
# docker-compose.yml (Postgres :5432, web :3010). Copy is applied only when
# .runtime/.env.release is first created. Edit that file afterwards.
#
# This file is not a secret store. Do not put production passwords here.

SKILLHUB_VERSION=v0.2.21
SKILLHUB_PUBLIC_BASE_URL=http://127.0.0.1:18088

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=skillhub
POSTGRES_USER=skillhub
POSTGRES_PASSWORD=change-this-skillhub-postgres-password

REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6380

API_PORT=18080
WEB_PORT=18088
SESSION_COOKIE_SECURE=false

SKILLHUB_STORAGE_PROVIDER=local
SKILLHUB_DOWNLOAD_ANON_COOKIE_SECRET=replace-with-random-download-secret-32-bytes

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-local-only
BOOTSTRAP_ADMIN_EMAIL=admin@skillhub.local

# Optional Casdoor OIDC. Leave blank for local bootstrap admin.
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_CLIENT_ID=
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_OIDC_CLIENT_SECRET=
# SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_OIDC_ISSUER_URI=https://casdoor.example.com
